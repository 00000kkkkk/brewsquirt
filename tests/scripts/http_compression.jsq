import http from "node:http"
import zlib from "node:zlib"

const seen = []
const brotli = Buffer.from("iwaAcGF5bG9hZCBmb3IgYnID", "base64")
const server = http.createServer((req, res) => {
  seen.push(`${req.url} ${req.headers["accept-encoding"] ?? "-"}`)
  const kind = req.url.slice(1)
  if (kind === "implicit") {
    res.statusCode = 202
    res._implicitHeader()
    res.end("implicit")
    return
  }
  const text = `payload for ${kind}`
  const bodies = {
    gzip: () => zlib.gzipSync(text),
    deflate: () => zlib.deflateSync(text),
    rawdeflate: () => zlib.deflateRawSync(text),
    br: () => brotli,
    plain: () => Buffer.from(text),
  }
  const body = bodies[kind]()
  const encoding = kind === "rawdeflate" ? "deflate" : kind === "plain" ? undefined : kind
  res.writeHead(200, { ...(encoding ? { "content-encoding": encoding } : {}), "content-length": body.length })
  res.end(body)
})
await new Promise((resolve) => server.listen(0, "127.0.0.1", resolve))
const base = `http://127.0.0.1:${server.address().port}`

for (const kind of ["plain", "gzip", "deflate", "rawdeflate", "br"]) {
  const r = await fetch(`${base}/${kind}`)
  console.log("fetch", kind, r.headers.get("content-encoding"), r.headers.get("content-length") !== null, await r.text())
}

const [encoding, raw] = await new Promise((resolve) =>
  http.get(`${base}/gzip`, (res) => {
    const chunks = []
    res.on("data", (c) => chunks.push(c))
    res.on("end", () => resolve([res.headers["content-encoding"], Buffer.concat(chunks)]))
  }),
)
console.log("http", encoding, raw[0] === 0x1f && raw[1] === 0x8b, zlib.gunzipSync(raw).toString())

const implicit = await fetch(`${base}/implicit`)
console.log("implicit", implicit.status, await implicit.text())
console.log(seen[0], seen[5])
server.close()
