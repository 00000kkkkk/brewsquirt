p.append("a", "2")
console.log(p.toString(), p.getAll("a"), p.has("b"), p.has("a", "3"))
p.delete("a", "1")
p.sort()
console.log(p.toString(), [...p])
console.log(new URLSearchParams("?q=%E2%9C%93+ok&e=&f").toString(), new URLSearchParams([["k", "v"]]).get("k"))
console.log(encodeURIComponent("a b&c/é✓"), encodeURI("http://x.com/a b?q=é&r=1#h"), decodeURIComponent("%E2%9C%93%20ok"), decodeURI("%2Fa%20b"))
try { decodeURIComponent("%E2%9C") } catch (e) { console.log(e.name, e.message) }
