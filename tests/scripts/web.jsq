const r = new Response("hello", { status: 201, headers: { "x-q": "1" } })
console.log(r.status, r.ok, r.headers.get("content-type"), r.bodyUsed, await r.text(), r.bodyUsed)
try { await r.text() } catch (e) { console.log(e.name) }
const j = Response.json({ a: 1 }, { status: 400 })
console.log(j.status, j.ok, j.headers.get("content-type"), await j.json())
const req = new Request("http://x.com/a?b=1", { method: "post", body: "data", headers: [["X-Y", "z"]] })
console.log(req.method, req.url, req.headers.get("x-y"), req.headers.get("content-type"), await req.text())
