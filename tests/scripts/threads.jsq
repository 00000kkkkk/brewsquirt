import { Worker, MessageChannel, isMainThread, threadId, receiveMessageOnPort } from "node:worker_threads"
import { once } from "node:events"

console.log("main", isMainThread, threadId)
const shared = new SharedArrayBuffer(16)
const counter = new Int32Array(shared)
const bytes = new Uint8Array([7, 8, 9]).buffer
const worker = new Worker(new URL("./fixtures/thread_worker.js", import.meta.url), {
  workerData: { shared, when: new Date(0), map: new Map([["k", 1]]), bytes },
  transferList: [bytes],
})
console.log("transferred", bytes.byteLength)
const [first] = await once(worker, "message")
console.log(first)
const { port1, port2 } = new MessageChannel()
worker.postMessage({ port: port2 }, [port2])
const [hello] = await once(port1, "message")
console.log(hello)
while (Atomics.load(counter, 1) === 0) Atomics.wait(counter, 1, 0, 50)
Atomics.store(counter, 2, 5)
Atomics.notify(counter, 2)
const [reply] = await once(port1, "message")
console.log(reply)
const [code] = await once(worker, "exit")
console.log("exit", code, Atomics.load(counter, 0))

const channel = new MessageChannel()
channel.port1.postMessage({ sync: [1, 2] })
console.log(receiveMessageOnPort(channel.port2), receiveMessageOnPort(channel.port2))
channel.port1.close()

const looping = new Worker("while (true) {}", { eval: true })
await once(looping, "online")
console.log("terminated", await looping.terminate())

const exiting = new Worker("process.exit(require('node:worker_threads').workerData)", { eval: true, workerData: 7 })
console.log("exit code", (await once(exiting, "exit"))[0])

const failing = new Worker("throw new RangeError('out of range')", { eval: true })
const [error] = await once(failing, "error")
console.log("error", error instanceof RangeError, error.message)

const cloned = structuredClone({ shared, list: [1, , 3], nested: { re: /a/g } })
cloned.shared === shared ? console.log("same object") : console.log("shares memory", new Int32Array(cloned.shared)[0])
console.log(cloned.list, cloned.nested.re.flags)
