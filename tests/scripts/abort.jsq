const target = new EventTarget()
const seen = []
const onPing = (e) => seen.push(`listener ${e.type} ${e.target === target}`)
target.addEventListener("ping", onPing)
target.addEventListener("ping", onPing)
target.addEventListener("ping", { handleEvent: (e) => seen.push("object " + e.type) }, { once: true })
target.dispatchEvent(new Event("ping"))
target.dispatchEvent(new Event("ping"))
target.removeEventListener("ping", onPing)
target.dispatchEvent(new Event("ping"))
console.log(seen)
const ev = new Event("x", { cancelable: true })
ev.preventDefault()
console.log(ev.type, ev.cancelable, ev.defaultPrevented, target.dispatchEvent(ev))

const ac = new AbortController()
const order = []
ac.signal.addEventListener("abort", () => order.push("listener"))
ac.signal.onabort = () => order.push("onabort")
console.log(ac.signal.aborted, ac.signal.reason)
ac.abort()
ac.abort("again")
console.log(ac.signal.aborted, ac.signal.reason.name, ac.signal.reason.message, ac.signal.reason instanceof DOMException, ac.signal.reason instanceof Error, order.sort())
try { ac.signal.throwIfAborted() } catch (e) { console.log("thrown", e.name, e.code) }
const custom = AbortSignal.abort(new Error("custom"))
console.log(custom.aborted, custom.reason.message)
const any = AbortSignal.any([new AbortController().signal, custom])
console.log(any.aborted, any.reason.message)
try { new AbortSignal() } catch (e) { console.log(e.name, e.message) }
const d = new DOMException("nope", "NotFoundError")
console.log(d.name, d.message, d.code, String(d), d instanceof Error)
const t = AbortSignal.timeout(20)
t.addEventListener("abort", () => console.log("timeout", t.reason.name, t.reason.message))
await new Promise((r) => setTimeout(r, 40))
const lazy = AbortSignal.timeout(100000)
console.log("lazy", lazy.aborted)
const r1 = new Response(new Uint8Array([104, 105, 0xe2, 0x9c, 0x93]))
console.log(r1.headers.get("content-type"), await r1.text())
const r2 = new Response("héllo")
console.log(new Uint8Array(await r2.arrayBuffer()))
const r3 = new Response(new Uint16Array([1, 2]).buffer)
console.log(await r3.bytes())
const r4 = new Request("http://x.com", { method: "POST", body: new Uint8Array([1, 2, 3]) })
console.log(r4.headers.get("content-type"), await r4.arrayBuffer())
