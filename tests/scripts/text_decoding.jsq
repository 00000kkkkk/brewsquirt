const bytes = new TextEncoder().encode("é€😀 ok")
const streaming = new TextDecoder()
let text = ""
for (let i = 0; i < bytes.length; i++) text += streaming.decode(bytes.subarray(i, i + 1), { stream: true })
text += streaming.decode()
console.log(JSON.stringify(text))

const utf16 = new TextDecoder("utf-16le")
const pair = new Uint8Array([0x3d, 0xd8, 0x00, 0xde])
console.log(JSON.stringify(utf16.decode(pair.subarray(0, 3), { stream: true }) + utf16.decode(pair.subarray(3))))

const samples = [
  ["windows-1251", [0xcf, 0xf0, 0xe8, 0xe2, 0xb3, 0xf2]],
  ["koi8-r", [0xf0, 0xd2, 0xc9]],
  ["gbk", [0xc4, 0xe3, 0xba, 0xc3]],
  ["shift_jis", [0x82, 0xa0, 0x82, 0xa2]],
  ["euc-kr", [0xc7, 0xd1]],
  ["big5", [0xa4, 0xa4]],
  ["iso-8859-2", [0xa1, 0xb1]],
  ["latin1", [0x80, 0xe9]],
]
for (const [label, data] of samples) {
  const d = new TextDecoder(label)
  console.log(label, d.encoding, d.decode(new Uint8Array(data)))
}

try {
  new TextDecoder("utf-8", { fatal: true }).decode(new Uint8Array([0xff]))
} catch (e) {
  console.log(e.name, e.code)
}
try {
  new TextDecoder("no-such-encoding")
} catch (e) {
  console.log(e.name)
}
console.log(new TextDecoder().decode(new Uint8Array([0xef, 0xbb, 0xbf, 0x41])), new TextDecoder("utf-8", { ignoreBOM: true }).decode(new Uint8Array([0xef, 0xbb, 0xbf, 0x41])).length)
