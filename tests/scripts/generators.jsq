function* count(from, to) {
  for (let i = from; i <= to; i++) yield i
}
console.log([...count(1, 5)])

function* fib() {
  let [a, b] = [0, 1]
  while (true) {
    yield a
    ;[a, b] = [b, a + b]
  }
}
const firstTen = []
for (const n of fib()) {
  if (firstTen.length === 10) break
  firstTen.push(n)
}
console.log(firstTen)

function* talk() {
  const name = yield "who?"
  const mood = yield `hi ${name}`
  return `${name} is ${mood}`
}
const t = talk()
console.log(t.next(), t.next("squirt"), t.next("wet"), t.next())

function* inner() {
  yield 1
  yield 2
}
function* outer() {
  yield 0
  yield* inner()
  yield* [3, 4]
  yield* "ab"
}
console.log(Array.from(outer()))

function* guarded() {
  try {
    yield 1
    yield 2
  } catch (e) {
    yield `caught ${e}`
  }
}
const g = guarded()
console.log(g.next().value, g.throw("boom").value, g.next().done)

const r = count(1, 3)
console.log(r.next().value, r.return(99), r.next())

class Tree {
  constructor(value, children = []) {
    this.value = value
    this.children = children
  }
  *[Symbol.iterator]() {
    yield this.value
    for (const c of this.children) yield* c
  }
}
const tree = new Tree(1, [new Tree(2, [new Tree(3)]), new Tree(4)])
console.log([...tree])

const range = {
  from: 1,
  to: 4,
  [Symbol.iterator]() {
    let cur = this.from
    const last = this.to
    return {
      next: () => (cur <= last ? { value: cur++, done: false } : { value: undefined, done: true }),
    }
  },
}
console.log([...range], Math.max(...range))
const [x, y, ...rest] = count(10, 15)
console.log(x, y, rest)

const lazy = {
  *map(it, f) {
    for (const v of it) yield f(v)
  },
}
console.log([...lazy.map(count(1, 3), (v) => v * 100)])
const gen = count(1, 2)
console.log(typeof gen.next, gen[Symbol.iterator]() === gen)
