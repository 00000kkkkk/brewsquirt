const m = new Map([["a", 1], ["b", 2]])
m.set("c", 3).set(NaN, "nan").set(0, "zero")
console.log(m.size, m.get("b"), m.get(NaN), m.get(-0), m.has("z"), m.delete("a"), m.delete("a"))
console.log(m)
console.log([...m.keys()], [...m.values()], [...m.entries()].length)
for (const [k, v] of m) console.log(k, v)
m.forEach((v, k) => console.log("each", k, v))
const objKey = {}
const wm = new Map([[objKey, "obj"]])
console.log(wm.get(objKey), wm.get({}))
const s = new Set([1, 2, 2, 3, 3, 3])
s.add(4).add(1)
console.log(s.size, s.has(2), s.has(9), s, [...s])
s.delete(2)
console.log([...s].map((x) => x * 10))
const uniq = [...new Set("mississippi")].join("")
console.log(uniq)
m.clear()
console.log(m.size, m)
const it = [1, 2].values()
console.log(it.next(), it.next(), it.next())
