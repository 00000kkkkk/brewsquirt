dirname ["/_app"] "/"
dirname ["/a/b"] "/a"
dirname ["C:\\a\\b"] "C:\\a"
dirname ["\\_app"] "\\"
dirname ["C:\\"] "C:\\"
dirname ["C:"] "C:"
dirname ["\\\\server\\share\\x"] "\\\\server\\share\\"
dirname ["a/b/"] "a"
dirname ["C:/x/y"] "C:/x"
basename ["C:\\a\\b.txt"] "b.txt"
basename ["/x/y/"] "y"
basename ["C:"] ""
extname ["a/.b"] ""
extname ["a.b.c"] ".c"
normalize ["/_app"] "\\_app"
normalize ["C:/a/../b"] "C:\\b"
normalize ["\\\\server\\share\\..\\x"] "\\\\server\\share\\x"
normalize ["a//b\\c/"] "a\\b\\c\\"
normalize ["C:"] "C:."
normalize [""] "."
resolve ["D:\\a","b"] "D:\\a\\b"
join ["/","_app"] "\\_app"
join ["C:","a"] "C:\\a"
join ["a","","b"] "a\\b"
relative ["C:\\a","C:\\a\\b\\c"] "b\\c"
relative ["C:\\a\\b","C:\\a\\c"] "..\\c"
relative ["C:\\a","D:\\b"] "D:\\b"
isAbsolute ["/x"] true
isAbsolute ["C:x"] false
isAbsolute ["C:\\x"] true
isAbsolute ["\\\\s\\h"] true
toNamespacedPath ["C:\\a"] "\\\\?\\C:\\a"
toNamespacedPath ["\\\\s\\h\\x"] "\\\\?\\UNC\\s\\h\\x"
parse ["C:\\a\\b.txt"] {"root":"C:\\","dir":"C:\\a","base":"b.txt","ext":".txt","name":"b"}
parse ["/x/y.z"] {"root":"/","dir":"/x","base":"y.z","ext":".z","name":"y"}
format [{"root":"C:\\","dir":"C:\\a","base":"b.txt"}] "C:\\a\\b.txt"
