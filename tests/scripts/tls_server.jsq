const https = require("node:https")
const tls = require("node:tls")
const fs = require("node:fs")
const path = require("node:path")
const { once } = require("node:events")

const key = fs.readFileSync(path.join(import.meta.dirname, "fixtures", "tls_key.pem"))
const cert = fs.readFileSync(path.join(import.meta.dirname, "fixtures", "tls_cert.pem"))

const server = https.createServer({ key, cert }, (req, res) => {
  let body = ""
  req.on("data", (d) => (body += d))
  req.on("end", () => {
    res.setHeader("content-type", "application/json")
    res.end(JSON.stringify({ method: req.method, url: req.url, body, encrypted: req.url.length > 0 }))
  })
})
server.listen(0, "127.0.0.1")
await once(server, "listening")
const port = server.address().port

const get = (options) =>
  new Promise((resolve, reject) => {
    const req = https.request({ host: "127.0.0.1", port, path: "/hello?x=1", method: "POST", ...options }, (res) => {
      let data = ""
      res.setEncoding("utf8")
      res.on("data", (c) => (data += c))
      res.on("end", () => resolve(`${res.statusCode} ${data}`))
    })
    req.on("error", reject)
    req.end("payload")
  })

console.log("https.request with ca:", await get({ ca: cert }))
console.log("https.request insecure:", await get({ rejectUnauthorized: false }))
console.log("https.request untrusted:", await get({}).then(() => "accepted", (e) => `${e.constructor.name} ${typeof e.code}`))

const r = await fetch(`https://localhost:${port}/fetched`, { tls: { ca: cert } })
console.log("fetch with ca:", r.status, (await r.json()).url)
console.log("fetch untrusted:", await fetch(`https://127.0.0.1:${port}/`).then(() => "accepted", (e) => e.message))
server.close()

const echo = tls.createServer({ key, cert }, (socket) => {
  socket.on("data", (d) => socket.end(`echo:${d}`))
})
echo.listen(0, "127.0.0.1")
await once(echo, "listening")
const echoPort = echo.address().port
const reply = await new Promise((resolve, reject) => {
  const sock = tls.connect({ host: "127.0.0.1", port: echoPort, ca: cert }, () => {
    sock.write("ping")
  })
  let data = ""
  sock.on("data", (d) => (data += d))
  sock.on("end", () => resolve(`${data} ${sock.encrypted}`))
  sock.on("error", reject)
})
console.log("tls echo:", reply)
const refused = await new Promise((resolve) => {
  const sock = tls.connect({ host: "127.0.0.1", port: echoPort }, () => resolve("connected"))
  sock.on("error", (e) => resolve(`error ${e.code}`))
})
console.log("tls untrusted:", refused)
echo.close()
try {
  https.createServer({}, () => {}).listen(0)
} catch (e) {
  console.log("missing key:", e.code)
}
