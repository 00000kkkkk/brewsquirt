const { Readable, Writable, Duplex, PassThrough, pipeline, finished } = require("node:stream")
const { text } = require("node:stream/consumers")
const fs = require("node:fs")
const path = require("node:path")
const os = require("node:os")

console.log((1.45).toFixed(1), (1.55).toFixed(1), (2.5).toFixed(0), (0.5).toFixed(0), (1.005).toFixed(2), (8.345).toFixed(2), (-2.5).toFixed(0), (1e21).toFixed(2), (0).toFixed(2))
console.log((2.5).toPrecision(1), (1.5).toPrecision(1), (25).toPrecision(1), (123.456).toPrecision(4), (0.000123).toPrecision(2), (-2.5).toPrecision(1), (1.45).toPrecision(2), (99.5).toPrecision(2))
console.log((12345678901234567890n).toLocaleString("de-DE"), (12345678901234567890n).toLocaleString("en-US"), (-1234n).toLocaleString("en-US", { style: "currency", currency: "USD" }), (1234567n).toLocaleString("en-IN"))
console.log("i".toLocaleUpperCase("tr"), "I".toLocaleLowerCase("tr-TR"), "İ".toLocaleLowerCase("tr"), "i".toLocaleUpperCase("en"), "I".toLocaleLowerCase(["az"]), "title".toLocaleUpperCase("az-Latn"))
const sparse = [1, , 3]
sparse[6] = 7
console.log(sparse.flat(), sparse.flat().length, [[1, , 2], [3]].flat(), sparse.filter(() => true))
const slow = new Writable({ highWaterMark: 4, write(chunk, encoding, cb) { setTimeout(cb, 1) } })
let drained = false
slow.on("drain", () => (drained = true))
const ok1 = slow.write("abc")
const ok2 = slow.write("defgh")
slow.end()
const main = async () => {
  await new Promise((resolve) => finished(slow, resolve))
  console.log(ok1, ok2, drained, slow.writableLength, slow.writableFinished)
  await new Promise((resolve) => pipeline(Readable.from(["x", "y"]), new PassThrough(), (err) => { console.log("pipeline cb", err); resolve() }))
  const web = Readable.toWeb(Readable.from(["a", "b"]))
  console.log(typeof web.getReader, await text(Readable.fromWeb(web)))
  const sink = []
  const ws = Writable.toWeb(new Writable({ write(chunk, enc, cb) { sink.push(String(chunk)); cb() } }))
  const writer = ws.getWriter()
  await writer.write("w1")
  await writer.write("w2")
  await writer.close()
  console.log(sink.join(), typeof Duplex.toWeb, typeof Duplex.fromWeb)
  const fromWeb = Writable.fromWeb(new WritableStream({ write(chunk) { sink.push(`web:${chunk}`) } }))
  fromWeb.write("z")
  fromWeb.end()
  await new Promise((resolve) => fromWeb.on("finish", resolve))
  console.log(sink.join())
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "jsq-diff2-"))
  const file = path.join(dir, "f.txt")
  const w = fs.createWriteStream(file)
  console.log(w.writableEnded, w.writableFinished, w.destroyed, w.closed)
  w.write("abc")
  w.end("def")
  await new Promise((resolve) => w.on("close", resolve))
  console.log(w.writableEnded, w.writableFinished, w.destroyed, w.closed, w.bytesWritten)
  const r = fs.createReadStream(file, { encoding: "utf8", start: 1, end: 4 })
  console.log(r.readableEnded, r.destroyed, r.closed)
  const chunks = []
  r.on("data", (c) => chunks.push(c))
  await new Promise((resolve) => r.on("close", resolve))
  console.log(chunks.join(""), r.readableEnded, r.destroyed, r.closed, r.bytesRead)
  fs.rmSync(dir, { recursive: true, force: true })
}
main()
