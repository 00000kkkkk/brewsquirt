const zlib = require("zlib")
const input = Buffer.from("hello hello hello ".repeat(50))
const c = zlib.zstdCompressSync(input)
console.log(c.toString("hex"))
console.log(zlib.zstdCompressSync(input, { params: { [zlib.constants.ZSTD_c_compressionLevel]: 19 } }).toString("hex"))
console.log(zlib.zstdDecompressSync(c).equals(input))
console.log(zlib.zstdDecompressSync(Buffer.concat([c, zlib.zstdCompressSync(Buffer.from("tail"))])).toString().slice(-8))
try {
  zlib.zstdDecompressSync(Buffer.from("garbage"))
} catch (e) {
  console.log(e.code, e.errno, e.message)
}
zlib.zstdCompress("callback data", (err, out) => {
  console.log(err, zlib.zstdDecompressSync(out).toString())
})
const { pipeline, Readable, Writable } = require("stream")
const chunks = []
pipeline(
  Readable.from([Buffer.from("stream "), Buffer.from("of "), Buffer.from("chunks")]),
  zlib.createZstdCompress(),
  zlib.createZstdDecompress(),
  new Writable({
    write(chunk, enc, cb) {
      chunks.push(chunk)
      cb()
    },
  }),
  (err) => console.log("pipeline", err, Buffer.concat(chunks).toString()),
)
console.log(zlib.constants.ZSTD_CLEVEL_DEFAULT, zlib.constants.ZSTD_c_compressionLevel, typeof zlib.ZstdCompress, zlib.createZstdCompress() instanceof zlib.ZstdCompress)
