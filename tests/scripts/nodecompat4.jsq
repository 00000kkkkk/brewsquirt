import make, { helper, VERSION } from "./fixtures/cjs_fn.js"
import { proc as reexportedProcess, cwd as reexportedCwd, pathNamespace } from "./fixtures/reexport_builtin.mjs"
console.log(make(21), helper("x"), VERSION)
console.log(reexportedProcess === process, reexportedCwd === process.cwd, typeof pathNamespace.join, String(process))

const shadow = function prime(n) {
  var prime = n + 1
  prime *= 2
  return prime
}
const strictSelf = function self() {
  "use strict"
  try {
    self = 1
  } catch (e) {
    return e.constructor.name
  }
}
console.log(shadow(1), strictSelf())

const timer = setTimeout(() => {}, 1000)
console.log(typeof timer, typeof timer.unref, timer.hasRef(), timer.unref() === timer, timer.hasRef(), +timer > 0, timer.ref().hasRef())
clearTimeout(timer)
setInterval(() => {}, 1000).unref()
const immediate = setImmediate(() => {})
console.log(typeof immediate.ref, immediate.hasRef(), typeof setTimeout[Symbol.for("nodejs.util.promisify.custom")])
clearImmediate(immediate)

const { addAbortListener, EventEmitter } = require("node:events")
const ac = new AbortController()
const disposable = addAbortListener(ac.signal, (e) => console.log("abort", e.type))
const unused = addAbortListener(ac.signal, () => console.log("never"))
unused[Symbol.dispose]()
ac.abort()
console.log(typeof disposable[Symbol.dispose], typeof EventEmitter.addAbortListener)

const stream = require("node:stream")
console.log(stream.getDefaultHighWaterMark(false), stream.getDefaultHighWaterMark(true))
stream.setDefaultHighWaterMark(true, 32)
console.log(stream.getDefaultHighWaterMark(true))

console.log(/\uD83D/.test("\uD83D"), /\u{D83D}/u.test("\uD83D"), "a\uD800b\uDFFFc".replace(/[\uD800-\uDFFF]/g, "?"), /^😀$/.test("😀"), /\uDE00/.test("\uDE00"))

const zlib = require("node:zlib")
const gz = new zlib.Gzip()
console.log(typeof gz._handle.close, gz._processChunk(Buffer.from("hello "), zlib.constants.Z_NO_FLUSH).length)
const packed = gz._processChunk(Buffer.from("world"), zlib.constants.Z_FINISH)
console.log(zlib.gunzipSync(packed).toString())
const gunzip = new zlib.Gunzip()
console.log(gunzip._processChunk(packed, zlib.constants.Z_FINISH).toString())
console.log(zlib.gunzipSync(Buffer.concat([zlib.gzipSync("padded"), Buffer.alloc(512)])).toString(), zlib.gunzipSync(Buffer.concat([zlib.gzipSync("two "), zlib.gzipSync("members")])).toString())

const vm = require("node:vm")
const sandbox = vm.createContext({ x: 2 })
vm.runInContext("this.y = x * 2; globalThis.z = y + 1; this.kind = typeof globalThis.Map", sandbox)
const windowLike = { Map: undefined }
windowLike.globalThis = windowLike
new vm.Script("this.Map = globalThis.Map; this.self = this === globalThis").runInContext(windowLike)
console.log(sandbox.y, sandbox.z, typeof globalThis.z, sandbox.kind, typeof Map, windowLike.self)

const http = require("node:http")
const util = require("node:util")
function MockResponse() {
  http.ServerResponse.call(this, {})
  this.chunks = []
}
util.inherits(MockResponse, http.ServerResponse)
MockResponse.prototype.write = function (data, encoding, cb) {
  http.ServerResponse.prototype.write.call(this, data, encoding, cb)
  this.chunks.push(String(data))
  return true
}
const mock = new MockResponse()
mock.once("finish", () => console.log("finish once", mock.writableFinished))
mock.setHeader("x-a", "1")
mock.setHeader("x-a", ["2", "3"])
mock.writeHead(201, { "content-type": "text/plain" })
mock.write("he")
mock.end("llo")
console.log(mock instanceof http.ServerResponse, mock.statusCode, mock.getHeader("x-a"), mock.getHeaderNames().join(), mock.chunks.join(""), mock.headersSent, mock.writableEnded, mock.listenerCount("finish"))
const message = new http.IncomingMessage()
console.log(message.method, message.url, typeof message.socket.address, message.listenerCount("end"), JSON.stringify(message.trailers))
console.log(mock._header.split("\r\n")[0], /content-type: text\/plain/.test(mock._header))

function MyInflate(opts) {
  zlib.Inflate.call(this, opts)
}
util.inherits(MyInflate, zlib.Inflate)
const inflater = new MyInflate()
const packedDeflate = zlib.deflateSync("sync inflate works")
const outBuf = Buffer.alloc(8)
let res = inflater._handle.writeSync(zlib.constants.Z_FINISH, packedDeflate, 0, packedDeflate.length, outBuf, 0, 8)
const pieces = [Buffer.from(outBuf.subarray(0, 8 - res[1]))]
while (res[1] === 0) {
  res = inflater._handle.writeSync(zlib.constants.Z_FINISH, null, 0, 0, outBuf, 0, 8)
  pieces.push(Buffer.from(outBuf.subarray(0, 8 - res[1])))
}
console.log(inflater instanceof zlib.Inflate, typeof inflater._chunkSize, Buffer.concat(pieces).toString())
console.log(new Buffer.allocUnsafeSlow(3).length, new (require("node:events").EventEmitterAsyncResource)({ name: "r" }).asyncResource.name, http.maxHeaderSize, typeof performance.eventLoopUtilization().utilization, typeof require("node:perf_hooks").monitorEventLoopDelay().percentile, typeof require("node:crypto").generateKeyPairSync)

class Wrapped extends Promise {
  then(onFulfilled, onRejected) {
    return super.then((v) => onFulfilled(`wrapped:${v}`), onRejected)
  }
}

const nodeCrypto = require("node:crypto")
;(async () => {
  console.log(await new Wrapped((resolve) => resolve("value")))
  const enc = new TextEncoder()
  const key = await crypto.subtle.importKey("raw", enc.encode("secret"), { name: "HMAC", hash: "SHA-256" }, false, ["sign", "verify"])
  console.log(key instanceof CryptoKey, Object.prototype.toString.call(key), key.type, key.extractable, key.algorithm.name, key.algorithm.hash.name, key.algorithm.length, key.usages.join())
  const sig = await crypto.subtle.sign("HMAC", key, enc.encode("data"))
  console.log(sig instanceof ArrayBuffer, Buffer.from(sig).toString("hex") === nodeCrypto.createHmac("sha256", "secret").update("data").digest("hex"))
  console.log(await crypto.subtle.verify("HMAC", key, sig, enc.encode("data")), await crypto.subtle.verify("HMAC", key, sig, enc.encode("other")))
  const jwkKey = await crypto.subtle.importKey("jwk", { kty: "oct", k: Buffer.from("secret").toString("base64url") }, { name: "HMAC", hash: "SHA-256" }, true, ["sign"])
  console.log(Buffer.from(await crypto.subtle.sign("HMAC", jwkKey, enc.encode("data"))).equals(Buffer.from(sig)), (await crypto.subtle.exportKey("jwk", jwkKey)).alg, Buffer.from(await crypto.subtle.exportKey("raw", jwkKey)).toString())
  const pb = await crypto.subtle.importKey("raw", enc.encode("pw"), "PBKDF2", false, ["deriveBits", "deriveKey"])
  const params = { name: "PBKDF2", hash: "SHA-256", salt: enc.encode("salt"), iterations: 100 }
  const bits = await crypto.subtle.deriveBits(params, pb, 128)
  console.log(Buffer.from(bits).toString("hex") === nodeCrypto.pbkdf2Sync("pw", "salt", 100, 16, "sha256").toString("hex"))
  const dk = await crypto.subtle.deriveKey(params, pb, { name: "HMAC", hash: "SHA-256", length: 128 }, true, ["sign"])
  console.log(Buffer.from(await crypto.subtle.exportKey("raw", dk)).equals(Buffer.from(bits)))
  const hk = await crypto.subtle.importKey("raw", enc.encode("ikm"), "HKDF", false, ["deriveBits"])
  const hbits = await crypto.subtle.deriveBits({ name: "HKDF", hash: "SHA-256", salt: enc.encode("s"), info: enc.encode("i") }, hk, 256)
  console.log(Buffer.from(hbits).toString("hex") === Buffer.from(nodeCrypto.hkdfSync("sha256", "ikm", "s", "i", 32)).toString("hex"))
  const gen = await crypto.subtle.generateKey({ name: "HMAC", hash: "SHA-512" }, true, ["sign"])
  console.log(gen.algorithm.length, (await crypto.subtle.exportKey("raw", gen)).byteLength)
  const digest = await crypto.subtle.digest("SHA-256", enc.encode("abc"))
  console.log(Buffer.from(digest).toString("hex").slice(0, 16))
  const failures = [
    () => crypto.subtle.sign("HMAC", pb, enc.encode("x")),
    () => crypto.subtle.encrypt({ name: "AES-GCM" }, key, enc.encode("x")),
    () => crypto.subtle.importKey("spki", new Uint8Array(4), { name: "RSA-PSS" }, false, ["verify"]),
    () => crypto.subtle.exportKey("raw", key),
  ]
  for (const bad of failures) {
    try {
      await bad()
      console.log("no error")
    } catch (e) {
      console.log(e.constructor.name, e.name)
    }
  }
})()
