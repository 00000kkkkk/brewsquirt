const out = []
const locales = ["en", "en-GB", "en-IN", "uk", "ru", "pl", "de", "de-CH", "de-AT", "fr", "fr-CH", "es", "es-MX", "it", "pt", "pt-PT", "nl", "sv", "fi", "da", "nb", "cs", "sk", "hu", "ro", "bg", "el", "tr", "he", "ar", "ar-EG", "fa", "hi", "bn", "mr", "ne", "ja", "zh", "zh-TW", "ko", "th", "vi", "id", "ms", "sw", "zu", "et", "lt", "lv", "sl", "hr", "sr", "sr-Latn", "be", "kk", "ka", "hy", "is", "ga", "cy", "my", "km", "lo", "ps", "ur"]
const nums = [0, -0, 1, -1, 1.5, -1234.5678, 1234, 12345, 123456.789, 1234567890.12, 0.000123, 1e21, NaN, Infinity, -Infinity]
for (const l of locales) {
  const fmt = (o, list = nums) => {
    const nf = new Intl.NumberFormat(l, o)
    return list.map((n) => nf.format(n)).join(" | ")
  }
  out.push(`${l} nu=${new Intl.NumberFormat(l).resolvedOptions().numberingSystem} ${new Intl.NumberFormat(l).resolvedOptions().locale}`)
  out.push(`${l} dec ${fmt({})}`)
  out.push(`${l} latn ${fmt({ numberingSystem: "latn" })}`)
  out.push(`${l} pct ${fmt({ style: "percent", maximumFractionDigits: 1 }, [0, 0.5, -0.256, 12.34])}`)
  out.push(`${l} eur ${fmt({ style: "currency", currency: "EUR" }, [0, 1, -1234.5, 1234567.891])}`)
  out.push(`${l} usd ${fmt({ style: "currency", currency: "USD" }, [1, -1234.5])}`)
  out.push(`${l} code ${fmt({ style: "currency", currency: "CHF", currencyDisplay: "code" }, [1, -1234.5])}`)
  out.push(`${l} acc ${fmt({ style: "currency", currency: "EUR", currencySign: "accounting" }, [1, -1234.5])}`)
  out.push(`${l} cs ${fmt({ notation: "compact" }, [999, 1000, 1500, 12345, 999999, 1000000, 2500000, 1e9, 1.2e12, 1e15, -54321])}`)
  out.push(`${l} cl ${fmt({ notation: "compact", compactDisplay: "long" }, [1000, 1500, 2000, 12345, 1000000, 2000000, 5000000, 1.5e6, 21e6, 1e9, 2e9, 1e12])}`)
  out.push(`${l} sci ${fmt({ notation: "scientific" }, [0, 12345, -0.00012, 1e21])}`)
  out.push(`${l} eng ${fmt({ notation: "engineering" }, [12345, 0.00012])}`)
  out.push(`${l} sign ${fmt({ signDisplay: "always" }, [0, 1, -1])} / ${fmt({ signDisplay: "exceptZero" }, [0, 1, -1, -0])} / ${fmt({ style: "percent", signDisplay: "always" }, [0.5])} / ${fmt({ style: "currency", currency: "EUR", signDisplay: "always" }, [5])}`)
  out.push(`${l} group ${fmt({ useGrouping: "always" }, [1234, 12345])} / ${fmt({ useGrouping: "min2" }, [1234, 12345])} / ${fmt({ useGrouping: false }, [1234567])}`)
  out.push(`${l} parts ${JSON.stringify(new Intl.NumberFormat(l, { style: "currency", currency: "EUR" }).formatToParts(-1234.5))}`)
}
out.push(new Intl.NumberFormat("en-u-nu-arab").format(-1234.5), new Intl.NumberFormat("ar-EG-u-nu-latn").format(-1234.5), new Intl.NumberFormat("fa", { numberingSystem: "latn" }).format(-1234.5), new Intl.NumberFormat("hi-u-nu-deva").format(1234567))
console.log(out.join("\n"))
