import http from "node:http"
import http2 from "node:http2"
import net from "node:net"

console.log(typeof http2.Http2ServerRequest, {} instanceof http2.Http2ServerRequest)

const server = http.createServer()
await new Promise((resolve) => server.listen(0, "127.0.0.1", resolve))
const port = server.address().port
let calls = 0
server.close(() => calls++)
await new Promise((resolve) => setTimeout(resolve, 10))
server.close((e) => console.log("second close", e.code))
await new Promise((resolve) => setTimeout(resolve, 10))
console.log("close callbacks", calls, server.address())

const started = Date.now()
try {
  await fetch(`http://127.0.0.1:${port}/`)
} catch (e) {
  console.log(e.name, e.message, e.cause.code, e.cause.syscall)
}
await new Promise((resolve) =>
  net.connect(port, "127.0.0.1").on("error", (e) => {
    console.log("net", e.code)
    resolve()
  }),
)
console.log("refused quickly", Date.now() - started < 1500)
