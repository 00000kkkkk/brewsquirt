const http = require("node:http")
const crypto = require("node:crypto")
const GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
const frame = (opcode, payload) => Buffer.concat([Buffer.from([0x80 | opcode, payload.length]), payload])

const server = http.createServer((req, res) => {
  res.setHeader("content-type", "text/plain")
  res.end("plain " + req.url)
})
server.on("upgrade", (req, socket, head) => {
  console.log("upgrade", req.method, req.url, req.headers.upgrade, head.length, typeof socket.write)
  const accept = crypto.createHash("sha1").update(req.headers["sec-websocket-key"] + GUID).digest("base64")
  socket.write(`HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: ${accept}\r\n\r\n`)
  let buffer = Buffer.alloc(0)
  socket.on("data", (chunk) => {
    buffer = Buffer.concat([buffer, chunk])
    while (buffer.length >= 2) {
      const opcode = buffer[0] & 0x0f
      const len = buffer[1] & 0x7f
      const offset = 6
      if (buffer.length < offset + len) return
      const payload = Buffer.alloc(len)
      for (let i = 0; i < len; i++) payload[i] = buffer[offset + i] ^ buffer[2 + (i & 3)]
      buffer = buffer.subarray(offset + len)
      if (opcode === 1) socket.write(frame(1, Buffer.from(`echo:${payload}`)))
      else if (opcode === 8) {
        socket.write(frame(8, payload))
        socket.end()
      }
    }
  })
  socket.on("close", () => finished("server socket closed"))
})

const closed = []
const finished = (what) => {
  closed.push(what)
  if (closed.length === 2) {
    console.log(closed.sort().join(" | "))
    server.close(() => console.log("server closed"))
  }
}

server.listen(0, "127.0.0.1", async () => {
  const port = server.address().port
  const plain = await fetch(`http://127.0.0.1:${port}/page`)
  console.log("fetch", plain.status, await plain.text())
  const ws = new WebSocket(`ws://127.0.0.1:${port}/socket`)
  ws.onopen = () => {
    console.log("open", ws.readyState)
    ws.send("hi")
  }
  ws.onmessage = (ev) => {
    console.log("message", ev.data)
    ws.close(1000, "bye")
  }
  ws.onclose = (ev) => finished(`client closed ${ev.code} ${ev.reason} ${ev.wasClean}`)
  ws.onerror = (ev) => console.log("error", ev.message)
})
