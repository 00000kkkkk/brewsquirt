const { fork } = require("node:child_process")
const { Worker, isMainThread } = require("node:worker_threads")
const once = (emitter, event) => new Promise((resolve) => emitter.once(event, (...args) => resolve(args)))

async function main() {
  console.log("main thread", isMainThread)
  const child = fork("./fixtures/ipc_child.jsq")
  console.log("forked", typeof child.send, child.connected)
  const [ready] = await once(child, "message")
  console.log("child says", ready)
  child.send({ n: 1, list: [1, 2] })
  const [reply] = await once(child, "message")
  console.log("reply", JSON.stringify(reply))
  child.send("bye")
  await once(child, "disconnect")
  console.log("disconnected", child.connected)
  const [code] = await once(child, "exit")
  console.log("child exit", code)

  const worker = new Worker("./fixtures/ipc_worker.jsq", { workerData: { tag: "w" } })
  await once(worker, "online")
  console.log("worker online", worker.threadId)
  worker.postMessage(21)
  const [answer] = await once(worker, "message")
  console.log("worker said", JSON.stringify(answer))
  worker.postMessage("boom")
  const [error] = await once(worker, "error")
  console.log("worker error", error.message)
  const [exitCode] = await once(worker, "exit")
  console.log("worker exit", exitCode)

  const inline = new Worker("const wt = require('node:worker_threads'); wt.parentPort.postMessage('inline ' + wt.workerData)", { eval: true, workerData: 7 })
  const [text] = await once(inline, "message")
  console.log(text)
  const terminated = await inline.terminate()
  console.log("terminated", typeof terminated)
}
main()
