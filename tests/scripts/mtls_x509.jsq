const https = require("https")
const tls = require("tls")
const fs = require("fs")
const path = require("path")
const { X509Certificate, createPrivateKey } = require("crypto")
const dir = path.join(import.meta.dirname, "fixtures", "mtls")
const read = (f) => fs.readFileSync(path.join(dir, f))
const ca = read("ca.pem")
const caCert = new X509Certificate(ca)
const full = new X509Certificate(read("full_cert.pem"))
console.log(full.subject.split("\n").join(" | "))
console.log(full.issuer, "|", full.subjectAltName)
console.log(full.infoAccess.split("\n").join(" | "))
console.log(full.validFrom, "->", full.validTo, full.validToDate.toISOString())
console.log(full.serialNumber.length, full.fingerprint256.length, full.keyUsage, full.ca, caCert.ca)
console.log(full.checkHost("example.com"), full.checkHost("x.example.org"), full.checkHost("a.b.example.org"), full.checkIP("::1"), full.checkIP("10.0.0.2"), full.checkEmail("admin@example.com"))
console.log(full.checkIssued(caCert), caCert.checkIssued(full), full.verify(caCert.publicKey), full.verify(full.publicKey))
console.log(full.checkPrivateKey(createPrivateKey(read("full_key.pem"))), full.checkPrivateKey(createPrivateKey(read("client_key.pem"))))
console.log(full.toString() === read("full_cert.pem").toString().replace(/\r\n/g, "\n"), full.raw.equals(new X509Certificate(full.raw).raw))
const legacy = full.toLegacyObject()
console.log(Object.keys(legacy).join(","))
console.log(legacy.subject.OU, legacy.infoAccess["OCSP - URI"], legacy.bits, legacy.exponent, legacy.ext_key_usage)
const ec = new X509Certificate(read("ec_cert.pem")).toLegacyObject()
console.log(ec.bits, ec.asn1Curve, ec.nistCurve, ec.pubkey.length, ec.pubkey[0])
const serverOpts = { key: read("server_key.pem"), cert: read("server_cert.pem"), ca, requestCert: true, rejectUnauthorized: true }
const who = (c) => (c && c.subject ? `${c.subject.CN} from ${c.issuer.CN}` : "none")
const tlsServer = tls.createServer(serverOpts, (s) => s.end(`server sees ${who(s.getPeerCertificate())} ${s.authorized}\n`))
const httpsServer = https.createServer(serverOpts, (req, res) => res.end(`server sees ${who(req.socket.getPeerCertificate())} ${req.socket.authorized}`))
const listen = (srv) => new Promise((r) => srv.listen(0, "127.0.0.1", () => r(srv.address().port)))
const tlsCall = (port, opts) =>
  new Promise((resolve) => {
    const s = tls.connect({ host: "localhost", port, ca, ...opts }, () => console.log("client sees", who(s.getPeerCertificate()), s.authorized))
    let out = ""
    s.on("data", (d) => (out += d))
    s.on("end", () => resolve(out.trim() || "rejected"))
    s.on("error", () => resolve("rejected"))
  })
const httpsCall = (port, opts) =>
  new Promise((resolve) => {
    https
      .get({ host: "localhost", port, ca, ...opts }, (res) => {
        let body = ""
        res.on("data", (d) => (body += d))
        res.on("end", () => resolve(`${res.statusCode} ${body}`))
      })
      .on("error", () => resolve("rejected"))
  })
;(async () => {
  const tp = await listen(tlsServer)
  const hp = await listen(httpsServer)
  console.log(await tlsCall(tp, { cert: read("client_cert.pem"), key: read("client_key.pem") }))
  console.log(await tlsCall(tp, {}))
  console.log(await httpsCall(hp, { cert: read("ec_cert.pem"), key: read("ec_key.pem") }))
  console.log(await httpsCall(hp, { cert: read("client_cert.pem"), key: read("client_key_enc.pem"), passphrase: "secret" }))
  console.log(await httpsCall(hp, { agent: new https.Agent({ cert: read("client_cert.pem"), key: read("client_key.pem"), ca }) }))
  console.log(await httpsCall(hp, {}))
  tlsServer.close()
  httpsServer.close()
})()
