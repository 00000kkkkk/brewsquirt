try { dv.getUint32(6) } catch (e) { console.log(e.name, e.message) }
console.log(ArrayBuffer.isView(dv), ArrayBuffer.isView(buf), buf.slice(2, 4), buf.byteLength, new Uint8Array(buf.slice(4)))
