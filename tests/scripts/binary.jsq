t.set([1, 2, 3], 2)
t.set(new Uint8Array([9]), 0)
console.log(t, Object.keys(t), Object.entries(new Uint8Array([4, 5])), t.length)
for (const x of new Uint8Array([10, 20])) console.log(x)
for (const k in new Uint8Array([10, 20])) console.log("key", k)
