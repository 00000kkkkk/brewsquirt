try { btoa("✓") } catch (e) { console.log(e.name) }
const orig = { n: 1, d: new Date(0), r: /x/gi, m: new Map([[1, { deep: [1, 2] }]]), s: new Set(["a"]), u: new Uint8Array([1, 2]), nested: { arr: [1, [2]] } }
orig.self = orig
const cl = structuredClone(orig)
console.log(cl, cl !== orig, cl.self === cl, cl.m.get(1) !== orig.m.get(1), cl.u.buffer !== orig.u.buffer, cl.d instanceof Date)
try { structuredClone({ f() {} }) } catch (e) { console.log(e.name) }
const e2 = structuredClone(new TypeError("bad"))
console.log(e2 instanceof TypeError, e2.message, e2.name)
const rnd = crypto.getRandomValues(new Uint8Array(16))
console.log(rnd.length, typeof crypto.randomUUID(), /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/.test(crypto.randomUUID()))
class Bytes extends Uint8Array {
  sum() { return this.reduce((a, b) => a + b, 0) }
}
const bb = new Bytes([1, 2, 3])
console.log(bb.sum(), bb instanceof Uint8Array, bb instanceof Bytes, bb.length)
