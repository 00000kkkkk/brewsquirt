const i8 = new Int8Array([127, 128, -129, 255, 1.9, -1.9, NaN, Infinity])
const u8c = new Uint8ClampedArray([-5, 300, 1.5, 2.5, 0.5, 254.5, NaN])
const u16 = new Uint16Array([65536, -1, 70000])
const i32 = new Int32Array([2 ** 31, -(2 ** 31) - 1, 4294967295])
const u32 = new Uint32Array([-1, 2 ** 32 + 5])
const f32 = new Float32Array([Math.PI, 1e40, -0])
const f64 = new Float64Array([Math.PI, -0, NaN])
console.log(i8, u8c, u16, i32, u32, f32, f64)
const buf = new ArrayBuffer(8)
const view = new Uint8Array(buf)
const words = new Uint16Array(buf, 2, 2)
words[0] = 0x1234
words[1] = 0xabcd
console.log(view, words, words.byteOffset, words.byteLength, words.length, words.buffer === buf, Uint16Array.BYTES_PER_ELEMENT)
const dv = new DataView(buf)
dv.setUint32(4, 0xdeadbeef)
dv.setInt16(0, -2, true)
console.log(view, dv.getUint32(4), dv.getUint32(4, true), dv.getInt16(0, true), dv.getUint8(0), dv.getFloat32(4))
dv.setFloat64(0, Math.E)
console.log(dv.getFloat64(0), dv.getFloat64(0, true), view)
const a = Uint8Array.from([5, 3, 9, 1], (x) => x * 2)
console.log(a, Uint8Array.of(1, 2, 300), Float64Array.from(new Set([1.5, 2.5])))
console.log(a.map((x) => x + 1), a.filter((x) => x > 5), a.reduce((s, x) => s + x, 0), a.join("-"), a.indexOf(18), a.includes(6), a.at(-1))
console.log([...a], Array.from(a.entries()), [...a.keys()], a.some((x) => x > 17), a.every((x) => x % 2 === 0), a.find((x) => x > 6), a.findLastIndex((x) => x < 10))
console.log(a.slice(1, 3), a.subarray(1, 3), a.toSorted(), a.toReversed(), a.with(0, 77), a)
const sub = a.subarray(1, 3)
sub[0] = 100
console.log(a, sub, sub.byteOffset)
a.sort((x, y) => y - x)
console.log(a, a.reverse(), a.fill(7, 1, 3), a.copyWithin(0, 2))
