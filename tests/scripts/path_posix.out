dirname ["/_app"] "/"
dirname ["/a/b"] "/a"
dirname ["a/b/"] "a"
dirname ["//x"] "//"
dirname ["a"] "."
dirname ["/"] "/"
dirname [""] "."
dirname ["C:\\a\\b"] "."
basename ["/x/y/"] "y"
basename ["a.js",".js"] "a"
basename ["/a/b.js","b.js"] "b.js"
basename ["x\\y"] "x\\y"
basename ["a.tar.gz",".gz"] "a.tar"
basename ["/"] ""
extname ["a/.b"] ""
extname ["a.b.c"] ".c"
extname [".."] ""
extname ["a."] "."
extname [".bashrc"] ""
extname ["a\\b.c"] ".c"
normalize ["/a/../../b"] "/b"
normalize ["a/../.."] ".."
normalize ["./"] "./"
normalize ["a//b/./c/"] "a/b/c/"
normalize [""] "."
normalize ["//a"] "/a"
normalize ["../a/.."] ".."
resolve ["/x","y","../z"] "/x/z"
resolve ["/a","/b","c"] "/b/c"
join ["/","_app"] "/_app"
join ["a","","b"] "a/b"
join ["",""] "."
join ["a/","/b/"] "a/b/"
join ["..","../x"] "../../x"
relative ["/a/b","/a/b/c/d"] "c/d"
relative ["/a/b/c","/a/d"] "../../d"
relative ["/a","/a"] ""
relative ["/a/b","/"] "../.."
relative ["/","/x"] "x"
isAbsolute ["/x"] true
isAbsolute ["x"] false
isAbsolute [""] false
parse ["/x/y.z"] {"root":"/","dir":"/x","base":"y.z","ext":".z","name":"y"}
parse ["/"] {"root":"/","dir":"/","base":"","ext":"","name":""}
parse ["a/b"] {"root":"","dir":"a","base":"b","ext":"","name":"b"}
parse [".bashrc"] {"root":"","dir":"","base":".bashrc","ext":"","name":".bashrc"}
parse ["/a/.."] {"root":"/","dir":"/a","base":"..","ext":"","name":".."}
parse ["a.b."] {"root":"","dir":"","base":"a.b.","ext":".","name":"a.b"}
parse ["/home/user/dir/file.txt"] {"root":"/","dir":"/home/user/dir","base":"file.txt","ext":".txt","name":"file"}
format [{"root":"/","dir":"/a","base":"b.txt"}] "/a/b.txt"
format [{"name":"x","ext":"js"}] "x.js"
format [{"root":"/","base":"f"}] "/f"
toNamespacedPath ["/a/b"] "/a/b"
