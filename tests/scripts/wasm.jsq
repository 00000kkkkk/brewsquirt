const leb = (n) => {
  const out = []
  n = BigInt(n)
  while (true) {
    const byte = Number(n & 0x7fn)
    n >>= 7n
    if ((n === 0n && (byte & 0x40) === 0) || (n === -1n && (byte & 0x40) !== 0)) {
      out.push(byte)
      return out
    }
    out.push(byte | 0x80)
  }
}
const uleb = (n) => {
  const out = []
  do {
    let b = n & 0x7f
    n >>>= 7
    if (n) b |= 0x80
    out.push(b)
  } while (n)
  return out
}
const str = (s) => [...uleb(s.length), ...[...s].map((c) => c.charCodeAt(0))]
const vec = (items) => [...uleb(items.length), ...items.flat()]
const section = (id, body) => [id, ...uleb(body.length), ...body]
const I32 = 0x7f, I64 = 0x7e, F32 = 0x7d, F64 = 0x7c, FUNCREF = 0x70
const func = (params, results) => [0x60, ...vec(params.map((p) => [p])), ...vec(results.map((r) => [r]))]
const body = (locals, code) => {
  const b = [...vec(locals), ...code, 0x0b]
  return [...uleb(b.length), ...b]
}
const module = (sections) => new Uint8Array([0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00, ...sections.flat()])

const bytes = module([
  section(1, vec([func([I32, I32], [I32]), func([I32], []), func([], [I32]), func([I64, I64], [I64]), func([I32, I32], [I32]), func([F64], [F64])])),
  section(2, vec([
    [...str("env"), ...str("log"), 0x00, 1],
    [...str("env"), ...str("mem"), 0x02, 0x00, 1],
  ])),
  section(3, vec([[0], [2], [3], [2], [4], [5]])),
  section(4, vec([[FUNCREF, 0x00, 2]])),
  section(6, vec([[I32, 0x01, 0x41, ...leb(7), 0x0b]])),
  section(7, vec([
    [...str("add"), 0x00, 1],
    [...str("run"), 0x00, 2],
    [...str("mul64"), 0x00, 3],
    [...str("boom"), 0x00, 4],
    [...str("div"), 0x00, 5],
    [...str("half"), 0x00, 6],
    [...str("mem"), 0x02, 0],
    [...str("tbl"), 0x01, 0],
    [...str("counter"), 0x03, 0],
  ])),
  section(9, vec([[0x00, 0x41, 0x00, 0x0b, ...vec([[1], [3]])]])),
  section(10, vec([
    body([], [0x20, 0x00, 0x20, 0x01, 0x6a]),
    body([], [0x41, 0x00, 0x41, ...leb(42), 0x36, 0x02, 0x00, 0x41, 0x00, 0x28, 0x02, 0x00, 0x10, 0x00, 0x23, 0x00, 0x41, 0x01, 0x6a, 0x24, 0x00, 0x41, 0x01, 0x40, 0x00]),
    body([], [0x20, 0x00, 0x20, 0x01, 0x7e]),
    body([], [0x00]),
    body([], [0x20, 0x00, 0x20, 0x01, 0x6d]),
    body([], [0x20, 0x00, 0x44, 0, 0, 0, 0, 0, 0, 0xe0, 0x3f, 0xa2]),
  ])),
  section(0, [...str("meta"), 1, 2, 3]),
])

console.log(typeof WebAssembly, String(WebAssembly), Object.keys(WebAssembly))
console.log(WebAssembly.validate(bytes), WebAssembly.validate(new Uint8Array([0, 97, 115, 109, 2, 0, 0, 0])))
const mod = new WebAssembly.Module(bytes)
console.log(WebAssembly.Module.imports(mod))
console.log(WebAssembly.Module.exports(mod))
console.log(WebAssembly.Module.customSections(mod, "meta").map((b) => [...new Uint8Array(b)]))
const memory = new WebAssembly.Memory({ initial: 1, maximum: 4 })
const logged = []
const instance = new WebAssembly.Instance(mod, { env: { log: (x) => logged.push(x), mem: memory } })
const e = instance.exports
console.log(Object.isFrozen(e), Object.getPrototypeOf(e), String(instance))
console.log(e.add(2, 3), e.add(2 ** 31 - 1, 1), e.add("7", 1.9), e.add.name, e.add.length, typeof e.add)
console.log(e.mul64(123456789n, 1000000007n), e.mul64(2n ** 63n - 1n, 2n))
console.log(e.half(5), e.half(-0.5))
const before = memory.buffer
console.log(before.byteLength, before === memory.buffer, e.mem === memory)
const view = new Uint32Array(memory.buffer)
view[1] = 99
console.log(e.counter.value)
console.log(e.run(), logged, view[0], new Uint32Array(memory.buffer)[1])
console.log(before.byteLength, memory.buffer.byteLength, e.counter.value)
e.counter.value = 100
e.run()
console.log(e.counter.value, logged)
console.log(memory.grow(1), memory.buffer.byteLength)
try {
  memory.grow(10)
} catch (err) {
  console.log(err.constructor.name, err.message)
}
console.log(e.tbl.length, e.tbl.get(0) === e.add, e.tbl.get(1)(6n, 7n), e.tbl.get(1) === e.mul64)
try {
  e.boom()
} catch (err) {
  console.log(err instanceof WebAssembly.RuntimeError, err.name, err.message)
}
try {
  e.div(1, 0)
} catch (err) {
  console.log(err.name, err.message)
}
try {
  e.div(-(2 ** 31), -1)
} catch (err) {
  console.log(err.name, err.message)
}
const thrower = new WebAssembly.Instance(mod, {
  env: {
    log: () => {
      throw new Error("from js")
    },
    mem: new WebAssembly.Memory({ initial: 1 }),
  },
})
try {
  thrower.exports.run()
} catch (err) {
  console.log(err.message)
}
try {
  new WebAssembly.Module(new Uint8Array([1, 2, 3]))
} catch (err) {
  console.log(err instanceof WebAssembly.CompileError, err.name)
}
try {
  new WebAssembly.Instance(mod, { env: { mem: memory } })
} catch (err) {
  console.log(err instanceof WebAssembly.LinkError, err.name)
}
const g = new WebAssembly.Global({ value: "i64", mutable: true }, 5n)
g.value = 9n
console.log(g.value, new WebAssembly.Global({ value: "f32" }, 1.1).value)
const t = new WebAssembly.Table({ element: "anyfunc", initial: 2 })
t.set(0, e.add)
console.log(t.length, t.get(0) === e.add, t.get(1), t.grow(3), t.length)
WebAssembly.instantiate(bytes, { env: { log() {}, mem: new WebAssembly.Memory({ initial: 1 }) } }).then(({ module, instance }) => {
  console.log(module instanceof WebAssembly.Module, instance instanceof WebAssembly.Instance, instance.exports.add(40, 2))
  return WebAssembly.instantiate(module, { env: { log() {}, mem: new WebAssembly.Memory({ initial: 1 }) } })
}).then((inst) => console.log(inst instanceof WebAssembly.Instance))
