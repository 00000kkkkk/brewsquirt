process.on("exit", (code) => console.log("exit", code, process.exitCode))
process.once("beforeExit", (code) => {
  console.log("beforeExit", code)
  setTimeout(() => console.log("late"), 1)
})
process.on("uncaughtException", (e, origin) => console.log("caught", e.message, origin))
process.on("unhandledRejection", (reason, p) => console.log("unhandled", reason.message, p instanceof Promise))
process.on("warning", (w) => console.log("warning", w.name, w.code))
process.emitWarning("odd", "CustomWarning", "W1")
console.log(process.listenerCount("exit"), process.eventNames().length)
Promise.reject(new Error("rejected"))
setTimeout(() => {
  throw new Error("boom")
}, 1)
process.exitCode = 0
