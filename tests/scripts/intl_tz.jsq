const d = new Date(Date.UTC(2026, 6, 1, 12, 0, 0))
const winter = new Date(Date.UTC(2026, 0, 15, 0, 0, 0))
const fmt = (tz, options) => new Intl.DateTimeFormat("en-US", { timeZone: tz, ...options }).format(d)
console.log(fmt("Asia/Tokyo", { hour: "numeric", minute: "2-digit", hour12: false }))
console.log(fmt("America/New_York", { hour: "numeric", minute: "2-digit", hour12: false }))
console.log(fmt("+05:30", { hour: "numeric", minute: "2-digit", hour12: false }))
console.log(fmt("UTC", { hour: "numeric", minute: "2-digit", hour12: false, timeZoneName: "short" }))
console.log(fmt("Europe/Kyiv", { timeZoneName: "short" }), fmt("Europe/Kyiv", { timeZoneName: "shortOffset" }), fmt("Europe/Kyiv", { timeZoneName: "longOffset" }))
console.log(new Intl.DateTimeFormat("en-US", { timeZone: "America/New_York", timeZoneName: "longOffset" }).format(winter))
console.log(d.toLocaleString("en-US", { timeZone: "America/New_York" }), d.toLocaleDateString("en-GB", { timeZone: "Pacific/Auckland" }), d.toLocaleTimeString("en-US", { timeZone: "Asia/Kolkata" }))
console.log(new Intl.DateTimeFormat("en-US", { timeZone: "asia/tokyo" }).resolvedOptions().timeZone, new Intl.DateTimeFormat("en-US", { timeZone: "etc/utc" }).resolvedOptions().timeZone, new Intl.DateTimeFormat("en-US", { timeZone: "-0330" }).resolvedOptions().timeZone)
for (const bad of ["Mars/Olympus", "+25:00", "Europe"]) {
  try {
    new Intl.DateTimeFormat("en-US", { timeZone: bad })
    console.log("accepted", bad)
  } catch (e) {
    console.log(e.constructor.name, bad)
  }
}
const zones = Intl.supportedValuesOf("timeZone")
console.log(zones.includes("Europe/Kyiv"), zones.includes("UTC"), zones.includes("US/Eastern"), zones.length > 300, zones.join() === [...zones].sort().join())
const system = Intl.DateTimeFormat().resolvedOptions().timeZone
console.log(typeof system, system.length > 0, system === "UTC" || system.includes("/"))
console.log(new Intl.DateTimeFormat("en-US", { timeZone: "Australia/Sydney", dateStyle: "full", timeStyle: "long" }).format(d))
console.log(new Intl.DateTimeFormat("en-US", { timeZone: "America/Los_Angeles", timeZoneName: "short", hour: "numeric" }).formatToParts(d).map((p) => p.type).join())
