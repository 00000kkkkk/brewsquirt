class A {
  who() {
    return "A"
  }
  get kind() {
    return "a-kind"
  }
}
class B extends A {}
class C extends B {}
class D extends C {}
const d = new D()
const call = (o) => o.who()
const read = (o) => o.kind
const out = []
for (let i = 0; i < 3; i++) out.push(call(d))
C.prototype.who = function () {
  return "C"
}
out.push(call(d))
delete C.prototype.who
out.push(call(d))
B.prototype.who = () => "B"
out.push(call(d))
Object.setPrototypeOf(C.prototype, A.prototype)
out.push(call(d))
Object.setPrototypeOf(C.prototype, { who: () => "X" })
out.push(call(d))
console.log(out.join(" "))
const kinds = []
for (let i = 0; i < 3; i++) kinds.push(read(d))
Object.defineProperty(C.prototype, "kind", { value: "c-kind", configurable: true })
kinds.push(read(d))
console.log(kinds.join(" "))
const base = { greet() { return "base" } }
let o = base
for (let i = 0; i < 40; i++) o = Object.create(o)
const greet = (x) => x.greet()
const g = []
for (let i = 0; i < 3; i++) g.push(greet(o))
let mid = o
for (let i = 0; i < 20; i++) mid = Object.getPrototypeOf(mid)
mid.greet = () => "mid"
g.push(greet(o))
console.log(g.join(" "))
const shapes = [{ x: 1 }, { y: 2, x: 2 }, { z: 3, y: 3, x: 3 }, { w: 4, x: 4 }, { v: 5, x: 5 }, Object.create({ x: 6 })]
const rx = (q) => q.x
const xs = []
for (let r = 0; r < 3; r++) for (const s of shapes) xs.push(rx(s))
shapes[5].x = 60
for (const s of shapes) xs.push(rx(s))
console.log(xs.join(","))
const arr = [1, 2, 3]
const meth = (a) => a.includes(2)
console.log(meth(arr), meth([5]))
Array.prototype.includes = () => "patched"
console.log(meth(arr))
