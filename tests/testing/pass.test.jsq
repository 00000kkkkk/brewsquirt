import { test, describe, expect, assert, beforeEach } from "squirt:test"

let counter = 0
beforeEach(() => {
  counter++
})

describe("math", () => {
  test("adds", () => {
    expect(1 + 2).toBe(3)
    expect(0.1 + 0.2).toBeCloseTo(0.3)
    expect(NaN).toBeNaN()
  })
  test("compares", () => {
    expect(5).toBeGreaterThan(3)
    expect(5).not.toBeLessThan(3)
  })
})

describe("objects", () => {
  test("deep equality", () => {
    expect({ a: [1, 2, { b: 3 }] }).toEqual({ a: [1, 2, { b: 3 }] })
    expect(new Map([[1, { x: 1 }]])).toEqual(new Map([[1, { x: 1 }]]))
    expect(new Set([1, 2])).not.toEqual(new Set([1, 3]))
    expect({ user: { name: "squirt", age: 3 } }).toMatchObject({ user: { name: "squirt" } })
    expect({ a: { b: 1 } }).toHaveProperty("a.b", 1)
  })
  test("collections", () => {
    expect([1, 2, 3]).toContain(2)
    expect([{ id: 1 }]).toContainEqual({ id: 1 })
    expect("javasquirt").toMatch(/squirt$/)
    expect([1, 2]).toHaveLength(2)
  })
})

test("throws", () => {
  expect(() => {
    throw new TypeError("bad input")
  }).toThrow("bad")
  expect(() => null.x).toThrow(TypeError)
  expect(() => 1).not.toThrow()
  assert.throws(() => JSON.parse("{"), SyntaxError)
})

test("async", async () => {
  const v = await new Promise((r) => setTimeout(() => r(42), 5))
  expect(v).toBe(42)
  await expect(Promise.resolve(7)).resolves.toBe(7)
  await expect(Promise.reject(new Error("nope"))).rejects.toThrow("nope")
})

test("hooks ran", () => {
  assert.equal(counter, 7)
  assert.deepEqual([1, { a: 2 }], [1, { a: 2 }])
})

test.skip("skipped", () => {
  throw new Error("never")
})
test.todo("later")
