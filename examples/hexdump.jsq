import { readFileSync } from "node:fs"

const file = process.argv[2] ?? "examples/hexdump.jsq"
const bytes = readFileSync(file).subarray(0, 64)

for (let offset = 0; offset < bytes.length; offset += 16) {
  const row = bytes.subarray(offset, offset + 16)
  const hex = Array.from(row, (b) => b.toString(16).padStart(2, "0")).join(" ")
  const text = Array.from(row, (b) => (b >= 32 && b < 127 ? String.fromCharCode(b) : ".")).join("")
  console.log(offset.toString(16).padStart(8, "0"), hex.padEnd(47), text)
}
console.log(`run ${crypto.randomUUID().slice(0, 8)}: ${bytes.length} bytes shown`)
