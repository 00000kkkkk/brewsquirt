import { serve } from "squirt:http"

const todos = [{ id: 1, title: "inject dependencies", done: true }]

const server = serve({ port: 0 }, async (req) => {
  const url = new URL(req.url)
  if (url.pathname === "/todos" && req.method === "GET") return todos
  if (url.pathname === "/todos" && req.method === "POST") {
    const todo = { id: todos.length + 1, done: false, ...(await req.json()) }
    todos.push(todo)
    return Response.json(todo, { status: 201 })
  }
  return new Response("not found", { status: 404 })
})

console.log(`listening on ${server.url}`)

const created = await fetch(new URL("/todos", server.url), {
  method: "POST",
  headers: { "content-type": "application/json" },
  body: JSON.stringify({ title: "go gluboko" }),
})
console.log(created.status, await created.json())

const list = await fetch(new URL("/todos", server.url)).then((r) => r.json())
console.log(list.map((t) => `${t.done ? "x" : " "} ${t.title}`).join("\n"))

server.stop()
